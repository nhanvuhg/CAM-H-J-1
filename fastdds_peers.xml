<!--
  Cross-host discovery profile cho Jetson/Pi 5 ↔ RevPi A.

  Switch của user KHÔNG forward multicast 239.255.0.1 → metatraffic
  discovery dùng InitialPeersList (unicast UDP) thay vì multicast group.

  Domain 22 → unicast metatraffic ports = PB(7400) + DG(250)*22 + d1(10)
  + PG(2)*participantId = 12910, 12912, 12914, 12916, 12918, ...

  Jetson runs many local participants in parallel. Its explicit locator list
  therefore covers participant IDs 0..27 (ports 12910..12964), including
  camera/AI, GUI and the ROS CLI daemon.

  IPs:
    172.16.11.11 = Jetson Orin Nano
    172.16.11.30 = Raspberry Pi 5
    172.16.11.31 = RevPi A

  ⚠ IP RevPi A phải khớp $REVPI_A_HOST trong ros2_env.sh.
     FastDDS không support env-var trong <address>, nên hãy chạy
     /home/pi/Desktop/update_revpi_ip.sh mỗi khi RevPi A đổi IP.
     Sanity check: bash scripts/check_revpi_ip_sync.sh
-->
<dds>
    <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
        <transport_descriptors>
            <!--
              Camera Image samples stay on shared memory when publisher and
              subscriber are both on the Jetson. UDP remains enabled for
              RevPi/Pi traffic. 640x360 BGR frames are below 1 MiB; a 16 MiB
              segment is sufficient and avoids reserving 64 MiB per participant.
              start_all removes only segments that no process still has open.
            -->
            <transport_descriptor>
                <transport_id>shm_transport</transport_id>
                <type>SHM</type>
                <segment_size>16777216</segment_size>
                <port_queue_capacity>64</port_queue_capacity>
                <healthy_check_timeout_ms>1000</healthy_check_timeout_ms>
            </transport_descriptor>
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>
                <type>UDPv4</type>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="xhost_unicast" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>shm_transport</transport_id>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
                <builtin>
                    <initialPeersList>
                        <!-- Jetson local participants (camera, CLI, GUI, etc.). -->
                        <locator>
                            <udpv4>
                                <address>172.16.11.11</address>
                                <port>12910</port>
                            </udpv4>
                        </locator>
                        <locator>
